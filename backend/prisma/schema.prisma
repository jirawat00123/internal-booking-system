generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id             Int        @id @default(autoincrement())
  departmentCode String?    @map("department_code")
  departmentName String     @map("department_name")
  employee       Employee[]
  positions      Position[]

  @@map("departments")
}

model Position {
  id           Int        @id @default(autoincrement())
  positionName String     @map("position_name")
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]

  @@index([departmentId])
  @@map("positions")
}

model Employee {
  id           Int        @id @default(autoincrement())
  employeeCode String     @unique @map("employee_code")
  fullName     String     @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  phone        String?    @map("phone")
  email        String?    @unique @map("email")
  positionId   Int        @map("position_id")
  departmentId Int        @map("departments_id")
  isActive     Boolean    @default(true) @map("is_active")
  department   Department @relation(fields: [departmentId], references: [id])
  position     Position   @relation(fields: [positionId], references: [id])
  users        User[]

  @@index([positionId])
  @@map("employees")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]

  @@map("roles")
}

model User {
  id                  Int              @id @default(autoincrement())
  employeeId          Int              @map("employee_id")
  roleId              Int              @map("role_id")
  pin                 String?          @map("pin_hash")
  pinInitialized      Boolean          @default(false) @map("pin_initialized")
  pinChangedAt        DateTime?        @map("pin_changed_at")
  pinResetRequired    Boolean          @default(false) @map("pin_reset_required")
  failedLoginAttempts Int              @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?        @map("locked_until")
  lastLoginAt         DateTime?        @map("last_login_at")
  active              Boolean          @default(true)
  isDeleted           Boolean          @default(false) @map("is_deleted")
  currentSessionId    String?          @map("current_session_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at")
  auditLogs           AuditLog[]
  roomBookings        RoomBooking[]
  employee            Employee         @relation(fields: [employeeId], references: [id])
  role                Role             @relation(fields: [roleId], references: [id])
  vehicleBookings     VehicleBooking[] @relation("BookingUser")
  vehicleLogsCheckOut VehicleLog[]     @relation("CheckoutByUser")
  vehicleLogsReturn   VehicleLog[]     @relation("ReturnByUser")
  managedVehicles     Vehicle[]        @relation("VehicleManager")
  attachments         Attachment[]
  notifications       Notification[]
  sentNotifications   Notification[]   @relation("NotificationActor")

  @@index([employeeId])
  @@index([roleId])
  @@map("users")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String
  module     String
  entityId   Int?     @map("entity_id")
  entityType String?  @map("entity_type")
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@map("audit_logs")
}

model Room {
  id          Int            @id @default(autoincrement())
  roomCode    String?        @unique @map("room_code")
  roomName    String         @map("room_name")
  floor       String?        @map("floor")
  location    String
  capacity    Int
  description String?        @map("description") @db.Text
  status      RoomStatus     @default(AVAILABLE)
  uploadUrl   String?        @map("upload_url")
  isDeleted   Boolean        @default(false) @map("is_deleted")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  bookings    RoomBooking[]
  facilities  RoomFacility[]

  @@map("rooms")
}

model RoomBooking {
  id            Int           @id @default(autoincrement())
  bookingCode   String?       @unique @default(uuid()) @map("booking_code")
  userId        Int           @map("user_id")
  roomId        Int           @map("room_id")
  purpose       String
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  endDatetime   DateTime      @map("end_datetime")
  startDatetime DateTime      @map("start_datetime")
  attachments   Attachment[]
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roomId])
  @@index([startDatetime, endDatetime])
  @@map("room_bookings")
}

model Vehicle {
  id             Int               @id @default(autoincrement())
  vehicleCode    String?           @unique @map("vehicle_code")
  vehicleName    String            @map("vehicle_name")
  plateNumber    String            @unique @map("license_plate")
  province       String?           @map("province")
  brand          String
  model          String
  color          String?           @map("color")
  year           Int?              @map("year")
  seats          Int               @default(4)
  currentMileage Int               @default(0) @map("current_mileage")
  status         VehicleStatus     @default(AVAILABLE)
  uploadUrl      String?           @map("upload_url")
  managerId      Int?              @map("manager_id")
  manager        User?             @relation("VehicleManager", fields: [managerId], references: [id])
  isDeleted      Boolean           @default(false) @map("is_deleted")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")
  bookings       VehicleBooking[]
  documents      VehicleDocument[]

  @@index([managerId])
  @@map("vehicles")
}

model VehicleBooking {
  id            Int           @id @default(autoincrement())
  bookingCode   String?       @unique @default(uuid()) @map("booking_code")
  vehicleId     Int           @map("vehicle_id")
  userId        Int           @map("user_id")
  destination   String
  startDatetime DateTime      @map("start_datetime")
  endDatetime   DateTime      @map("end_datetime")
  purpose       String
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  passengers    Int           @default(1) @map("passengers")
  attachments   Attachment[]
  user          User          @relation("BookingUser", fields: [userId], references: [id])
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  vehicleLogs   VehicleLog[]

  @@index([vehicleId])
  @@index([userId])
  @@map("vehicle_bookings")
}

model VehicleLog {
  id                 Int            @id @default(autoincrement())
  vehicleBookingId   Int            @map("vehicle_booking_id")
  checkoutById       Int            @map("checkout_by")
  checkoutTime       DateTime       @map("checkout_time")
  checkoutMileage    Int            @map("checkout_mileage")
  checkoutFuelLevel  Int            @map("checkout_fuel_level")
  returnById         Int?           @map("return_by")
  returnTime         DateTime?      @map("return_time")
  returnMileage      Int?           @map("return_mileage")
  returnFuelLevel    Int?           @map("return_fuel_level")
  returnMileagePhoto String?        @map("return_mileage_photo")
  returnFrontPhoto   String?        @map("return_front_photo")
  returnBackPhoto    String?        @map("return_back_photo")
  remark             String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  checkoutBy         User           @relation("CheckoutByUser", fields: [checkoutById], references: [id])
  returnBy           User?          @relation("ReturnByUser", fields: [returnById], references: [id])
  booking            VehicleBooking @relation(fields: [vehicleBookingId], references: [id])

  @@index([vehicleBookingId])
  @@index([checkoutById])
  @@index([returnById])
  @@map("vehicle_logs")
}

model Attachment {
  id               Int             @id @default(autoincrement())
  entityType       String          @map("entity_type")
  entityId         Int             @map("entity_id")
  fileName         String          @map("file_name")
  filePath         String          @unique @map("file_path")
  fileType         String          @map("file_type")
  uploadedById     Int             @map("uploaded_by")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  vehicleBookingId Int?            @map("vehicle_booking_id")
  roomBookingId    Int?            @map("room_booking_id")
  bookingRoom      RoomBooking?    @relation(fields: [roomBookingId], references: [id], onDelete: Cascade)
  uploadedBy       User            @relation(fields: [uploadedById], references: [id])
  bookingVehicle   VehicleBooking? @relation(fields: [vehicleBookingId], references: [id], onDelete: Cascade)
  isDeleted        Boolean         @default(false) @map("is_deleted")

  @@index([vehicleBookingId])
  @@index([roomBookingId])
  @@index([uploadedById])
  @@index([entityType, entityId])
  @@map("attachments")
}

model Facility {
  id           Int            @id @default(autoincrement())
  name         String         @unique @map("name")
  icon         String?        @map("icon")
  displayOrder Int            @default(0) @map("display_order")
  category     String?        @map("category")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  rooms        RoomFacility[]

  @@map("facilities")
}

model RoomFacility {
  roomId     Int      @map("room_id")
  facilityId Int      @map("facility_id")
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([roomId, facilityId])
  @@index([roomId])
  @@index([facilityId])
  @@map("room_facilities")
}

model DocumentType {
  id           Int               @id @default(autoincrement())
  name         String            @unique @map("name")
  icon         String?           @map("icon")
  displayOrder Int               @default(0) @map("display_order")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  documents    VehicleDocument[]

  @@map("document_types")
}

model VehicleDocument {
  id             Int       @id @default(autoincrement())
  vehicleId      Int       @map("vehicle_id")
  documentTypeId Int       @map("document_type_id")
  documentNumber String?   @map("document_number")
  issueDate      DateTime? @map("issue_date")
  expiryDate     DateTime? @map("expiry_date")
  remark         String?   @map("remark") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@index([documentTypeId])
  @@index([expiryDate])
  @@map("vehicle_documents")
}

// 🟢 🆕 เพิ่ม Model สำหรับ Notification Center
model Notification {
  id Int @id @default(autoincrement())

  userId  Int  @map("user_id")
  actorId Int? @map("actor_id")

  title   String
  message String @db.Text

  type NotificationType

  action String? @map("action")

  entityType String? @map("entity_type")
  entityId   Int?    @map("entity_id")

  targetRoute String? @map("target_route")

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId, isRead])
  @@index([entityType, entityId])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

enum RoomStatus {
  AVAILABLE
  IN_USE      @map("IN USE")
  RESERVED
  MAINTENANCE
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  IN_USE      @map("IN USE")
  RESERVED
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  RESERVED
  IN_USE    @map("IN USE")
  CANCELLED
  COMPLETED
}

// 🟢 🆕 เพิ่ม Enum สำหรับแยกประเภท Notification
enum NotificationType {
  BOOKING
  APPROVAL
  REMINDER
  DOCUMENT
  SECURITY
  SYSTEM
  VEHICLE
  ROOM
}
